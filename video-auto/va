#!/bin/bash
# vauto 실행 도우미.  예: ./va run /Volumes/외장SSD/촬영/2026-11-전시회
SELF="$0"
[ -L "$SELF" ] && SELF="$(readlink "$SELF")"
DIR="$(cd "$(dirname "$SELF")" && pwd)"
[ -d /opt/homebrew/bin ] && case ":$PATH:" in *":/opt/homebrew/bin:"*) ;; *) PATH="/opt/homebrew/bin:$PATH" ;; esac
# Homebrew 기본 ffmpeg 에 자막·HDR 필터가 빠져 있을 때 설치하는 전체판을 먼저 찾는다
[ -d /opt/homebrew/opt/ffmpeg-full/bin ] && PATH="/opt/homebrew/opt/ffmpeg-full/bin:$PATH"
command -v uv >/dev/null 2>&1 || { echo "uv 가 없습니다. ./setup-video.sh 를 먼저 실행하세요." >&2; exit 1; }
# setup-voice.sh 가 고른 목소리 방식(voice-mlx 또는 voice-torch)을 함께 불러온다
EXTRA=()
[ -f "$DIR/.voice-extra" ] && EXTRA=(--extra "$(cat "$DIR/.voice-extra")")
exec uv run --quiet --project "$DIR" "${EXTRA[@]}" vauto "$@"
