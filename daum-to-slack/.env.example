# ===== 필수 설정 =====
# 다음 메일 주소
DAUM_EMAIL=yourid@daum.net
# 비밀번호 (카카오 2단계 인증을 쓰면 반드시 '앱 비밀번호'를 넣으세요)
DAUM_PASSWORD=여기에_비밀번호_또는_앱비밀번호
# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ

# ===== 선택 설정 (보통 그대로 두면 됩니다) =====
IMAP_HOST=imap.daum.net
IMAP_PORT=993
MAILBOX=INBOX
# 확인 간격(초). 0 이면 1회만 실행하고 종료
POLL_INTERVAL=60
# true 로 바꾸면 기존 메일함의 과거 메일도 전송 (주의: 한꺼번에 많이 올 수 있음)
FORWARD_EXISTING=false
# Slack 에 보낼 본문 최대 글자수
BODY_MAX_CHARS=500
